# Copy to .env and set a long random value:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me
FLASK_DEBUG=0

# Optional: send real password-reset e-mails (e.g. Gmail with an App Password).
# If SMTP_HOST is empty, the reset link is printed in the terminal (good for local demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
